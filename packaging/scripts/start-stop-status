#!/bin/sh
PKG=cyklosub
TARGET=/var/packages/$PKG/target
VAR=/var/packages/$PKG/var
PIDF=$VAR/cyklo.pid
LOG=$VAR/cyklo.log
running() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }
case "$1" in
  start)
    running && exit 0
    mkdir -p "$VAR/data"
    [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 1048576 ] && : > "$LOG"
    CYKLO_DATA="$VAR/data" CYKLO_PORT=8765 nohup "$TARGET/bin/cyklo" >> "$LOG" 2>&1 &
    echo $! > "$PIDF"
    sleep 1
    running && exit 0
    exit 1 ;;
  stop)
    if running; then
      kill "$(cat "$PIDF")"
      i=0; while running && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done
      running && kill -9 "$(cat "$PIDF")"
    fi
    rm -f "$PIDF"
    exit 0 ;;
  status)
    running && exit 0
    exit 3 ;;
  *) exit 0 ;;
esac
